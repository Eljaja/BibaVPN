# Copy to `.env` in this directory or set in the shell before `cargo build` / `npm run tauri dev`.
# In GitHub Actions: repository secret BIBA_BYPASS_DOMAINS_URL (Settings → Secrets → Actions).
#
# JSON (full list + presets):
BIBA_BYPASS_DOMAINS_URL=https://biba-llc.com/api/v1/config/bypass-domains
#
# Plain text (one domain per line):
# BIBA_BYPASS_DOMAINS_URL=https://biba-llc.com/api/v1/config/bypass-domains?format=plain
#
# Single preset, e.g. banks:
# BIBA_BYPASS_DOMAINS_URL=https://biba-llc.com/api/v1/config/bypass-domains?preset=banks
