{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BibaVPN",
  "version": "0.2.0",
  "identifier": "dev.bibavpn.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ./ui",
    "beforeBuildCommand": "npm run build --prefix ./ui",
    "features": ["boring-tls"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BibaVPN",
        "width": 480,
        "height": 720,
        "minWidth": 400,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --proxy-server=direct://"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["bibavpn"]
      },
      "mobile": [
        {
          "scheme": ["bibavpn"],
          "host": "import"
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "android": {
      "minSdkVersion": 24,
      "autoIncrementVersionCode": false
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
