# Build from repo root: biba-vpn/biba-vpn (contains Cargo.toml workspace)
FROM rust:1.89-bookworm AS chef
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY biba ./biba
COPY bibavpn ./bibavpn
COPY apps/bibavpn-jni ./apps/bibavpn-jni
COPY apps/bibavpn-desktop ./apps/bibavpn-desktop
RUN cargo build --release -p bibavpn --bin bibavpn-client

FROM debian:bookworm-slim
LABEL org.opencontainers.image.source="https://github.com/Eljaja/BibaVPN" \
      org.opencontainers.image.description="BibaVPN client — SOCKS5/HTTP-CONNECT tunnel over TLS+WebSocket" \
      org.opencontainers.image.licenses="MIT"
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=chef /app/target/release/bibavpn-client /usr/local/bin/bibavpn-client
EXPOSE 1080 18080
ENTRYPOINT ["/usr/local/bin/bibavpn-client"]
